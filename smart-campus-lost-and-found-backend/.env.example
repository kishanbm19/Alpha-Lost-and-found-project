# PostgreSQL Database (Neon Cloud with pgvector enabled)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# JWT Authentication (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace_with_64_character_hex_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Campus Email Domain Restriction (Leave blank during testing; set to nie.ac.in for production)
ALLOWED_EMAIL_DOMAIN=

# Frontend CORS Origins (Comma-separated list of allowed frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary Media Storage (From Cloudinary Console -> Settings -> API Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Hugging Face Inference API (For CLIP image & MiniLM text embeddings)
HF_TOKEN=hf_your_hugging_face_access_token